function readUpload(file){
  if (typeof XLSX === "undefined"){ toast("The Excel reader didn't load. Check your connection and reload the page."); return; }
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const wb = XLSX.read(new Uint8Array(e.target.result), {type:"array", cellDates:false});
      const aoa = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], {header:1, defval:"", raw:true});
      const res = parseSheet(aoa);
      if (res.error){ pendingUpload = null; $("#upPrev").innerHTML = '<div class="banner" style="margin-top:14px">' + esc(res.error) + '</div>'; return; }
      pendingUpload = Object.assign(res, {file: file.name}); $("#upPrev").innerHTML = uploadPreview(); bindUploadPreview($("#pane"));
    } catch(ex){ $("#upPrev").innerHTML = '<div class="banner" style="margin-top:14px">Couldn\'t read that file. Save it as .xlsx and try again.</div>'; }
  };
  reader.readAsArrayBuffer(file);
}
