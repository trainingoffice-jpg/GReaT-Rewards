function redeems(){ return coll("redeem"); }
function spentOf(key){ return redeems().reduce((a, x) => a + (x.key === key && x.status !== "rejected" ? (+x.pts || 0) : 0), 0); }
function walletOf(key){ return memo("w:" + key, () => { const e = earnedOf(key), s = spentOf(key); return {earned:e, spent:s, bal:e - s}; }); }
function peerUsed(key, m){ m = m || curMonth(); return recs().reduce((a, r) => a + (r.from === key && r.kind === "peer" && monthOf(r.ts) === m ? (+r.pts || 0) * (r.to || []).length : 0), 0); }
