function pwProblem(pw, emp){
  if (pw.length < 6) return "Use at least 6 characters.";
  if (pw.length > 40) return "Use 40 characters or fewer.";
  if (!/[A-Za-z]/.test(pw) || !/\d/.test(pw)) return "Include at least one letter and one number.";
  if (pw === defaultPin(emp.id) || pw.toLowerCase() === String(emp.id).toLowerCase()) return "Don't use your employee ID or the temporary password.";
  return "";
}

