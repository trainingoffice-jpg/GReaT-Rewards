<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>GReaT Rewards</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&family=Noto+Sans+Tamil:wght@400;600;700&family=Noto+Sans+Telugu:wght@400;600;700&family=Noto+Sans+Kannada:wght@400;600;700&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
/* GReaT Rewards — "hallmark ledger": flat stone paper, ink rules, jeweller's price-tags and hallmark punch strips.
   Layout: sticky ink top bar, parallax masthead per page, asymmetric main column + side rail. */
:root{
  --paper:#e7eae4; --paper-2:#dce1d9; --card:#f6f7f3; --ink:#11211b; --ink-2:#34433c; --muted:#5f6d66;
  --hair:#c3cbc2; --rule:#11211b;
  --em:#0d5a44; --em-2:#0a4636; --em-soft:#d3e4dc; --brass:#9b7217; --brass-hi:#d9b14e; --brass-soft:#efe3c3;
  --lac:#b0362a; --lac-soft:#f2d9d4; --ok:#1d6b45; --ok-soft:#d6eadf; --warn:#8a6100; --warn-soft:#f1e4c2;
  --on-em:#ffffff; --stage:#0b3a2d; --stage-ink:#e9efe9;
  --f-disp:"Big Shoulders Display","Archivo Narrow","Arial Narrow",Impact,sans-serif;
  --f-body:"Archivo","Noto Sans Tamil","Noto Sans Telugu","Noto Sans Kannada","Noto Sans Devanagari",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --hard:3px 3px 0 var(--ink);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --paper:#0d1411; --paper-2:#131c18; --card:#16211c; --ink:#e4ebe6; --ink-2:#c3cec7; --muted:#93a39b; --hair:#2b3833; --rule:#e4ebe6;
  --em:#4fbf93; --em-2:#3da67e; --em-soft:#17342a; --brass:#d9b14e; --brass-hi:#e9c76a; --brass-soft:#352a12;
  --lac:#ef7360; --lac-soft:#3b1d18; --ok:#57c48a; --ok-soft:#173226; --warn:#e2b94f; --warn-soft:#352a12;
  --on-em:#04170f; --stage:#07231b; --stage-ink:#e9efe9; color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#0d1411; --paper-2:#131c18; --card:#16211c; --ink:#e4ebe6; --ink-2:#c3cec7; --muted:#93a39b; --hair:#2b3833; --rule:#e4ebe6;
  --em:#4fbf93; --em-2:#3da67e; --em-soft:#17342a; --brass:#d9b14e; --brass-hi:#e9c76a; --brass-soft:#352a12;
  --lac:#ef7360; --lac-soft:#3b1d18; --ok:#57c48a; --ok-soft:#173226; --warn:#e2b94f; --warn-soft:#352a12;
  --on-em:#04170f; --stage:#07231b; --stage-ink:#e9efe9; color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html,body{min-height:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 var(--f-body);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--f-disp);font-weight:800;line-height:1;margin:0;letter-spacing:.005em;text-wrap:balance}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--brass);outline-offset:2px}
a{color:var(--em)}
.num,td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
.mono{font-family:var(--f-mono)}
.sub{color:var(--muted);font-size:14px}
.dept{color:var(--muted);font-size:13px}
.hint{font-size:13px;color:var(--muted);margin:2px 0 12px}
.err{color:var(--lac);font-size:14px;min-height:20px;margin:4px 0 8px;font-weight:600}
.grow{flex:1}

/* Buttons: square, ink outline; primary carries the only hard shadow */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1.5px solid var(--ink);background:var(--card);color:var(--ink);padding:9px 15px;border-radius:2px;cursor:pointer;font-weight:600;font-size:14px;line-height:1.2;text-decoration:none;white-space:nowrap}
.btn:hover{background:var(--paper-2)}
.btn.primary{background:var(--em);border-color:var(--ink);color:var(--on-em);box-shadow:var(--hard)}
.btn.primary:hover{background:var(--em-2)}
.btn.primary:active,.btn.gold:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}
.btn.gold,.btn.glow{background:var(--brass-hi);color:#1b1404;border-color:var(--ink);box-shadow:var(--hard)}
.btn.ghost{border-color:transparent;background:transparent}
.btn.ghost:hover{border-color:var(--hair)}
.btn.small{padding:5px 10px;font-size:13px}
.btn.danger{color:var(--lac);border-color:var(--lac)}
.btn.link{border:0;background:none;color:var(--em);padding:2px 0;text-decoration:underline;text-underline-offset:3px;box-shadow:none}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
.xbtn{border:0;background:none;color:var(--muted);cursor:pointer;font-size:20px;line-height:1;padding:2px 8px}
.xbtn:hover{color:var(--lac)}
.actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center}

/* Forms */
input,select,textarea{background:var(--card);border:1.5px solid var(--hair);border-radius:2px;padding:9px 11px;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--ink);outline:none}
select.inline,input.inline{width:auto}
textarea{min-height:84px;resize:vertical}
.field{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.field label,.lbl{font-family:var(--f-mono);font-size:11.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2)}
.banner{border:1.5px solid var(--ink);background:var(--brass-soft);padding:10px 14px;margin:0 0 16px;font-size:14px}
.banner.info{background:var(--em-soft)}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:16px}

/* ---------- Top bar ---------- */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:var(--ink);color:var(--paper)}
.bar-in{max-width:1240px;margin:0 auto;padding:0 20px;display:flex;align-items:center;gap:22px;min-height:58px}
.wm{font-family:var(--f-disp);font-weight:900;font-size:24px;letter-spacing:.02em;text-transform:uppercase;line-height:1;display:flex;align-items:center;gap:8px;white-space:nowrap}
.wm i{font-style:normal;color:var(--brass-hi)}
.wm .hmk{font-family:var(--f-mono);font-size:10px;font-weight:600;letter-spacing:.06em;border:1px solid currentColor;padding:2px 4px;opacity:.75}
.nav{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;flex:1;align-self:stretch}
.nav::-webkit-scrollbar{display:none}
.nav button{border:0;background:none;color:inherit;opacity:.72;padding:0 12px;cursor:pointer;font-weight:600;font-size:14px;white-space:nowrap;border-bottom:3px solid transparent;border-top:3px solid transparent}
.nav button:hover{opacity:1}
.nav button[aria-selected="true"]{opacity:1;border-bottom-color:var(--brass-hi)}
.tabcount{display:inline-block;margin-left:6px;font-family:var(--f-mono);font-size:11px;background:var(--lac);color:#fff;padding:1px 6px;vertical-align:1px}
.bar-r{display:flex;align-items:center;gap:8px}
.bar-r .btn{color:var(--paper);border-color:transparent;background:transparent;padding:6px 8px;font-size:13px}
.bar-r .btn:hover{border-color:rgba(255,255,255,.35)}
:root[data-theme="dark"] .bar-r .btn:hover{border-color:var(--hair)}
.langsel select{background:transparent;border:1px solid rgba(255,255,255,.3);color:inherit;padding:5px 8px;font-size:13px;width:auto;border-radius:2px}
.langsel select option{color:#11211b}
.langsel span{display:none}
.bar .langsel select{border-color:color-mix(in srgb,var(--paper) 30%,transparent)}

/* ---------- Parallax masthead ---------- */
.mast{position:relative;overflow:hidden;border-bottom:1.5px solid var(--rule);background:var(--paper-2);isolation:isolate}
.mast .layer{position:absolute;inset:0;pointer-events:none;will-change:transform}
.mast .words{display:flex;flex-direction:column;justify-content:center;gap:0;padding-left:2vw;opacity:.9}
.mast .words span{font-family:var(--f-disp);font-weight:900;font-size:clamp(70px,13vw,180px);line-height:.86;white-space:nowrap;color:transparent;-webkit-text-stroke:1.2px color-mix(in srgb,var(--ink) 22%,transparent);text-transform:uppercase}
.mast .words span:nth-child(2){padding-left:12vw}
.mast .words span:nth-child(3){padding-left:4vw}
.mast-in{position:relative;max-width:1240px;margin:0 auto;padding:34px 20px 26px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:end;will-change:transform}
.eyebrow{font-family:var(--f-mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2)}
.mast h1{font-size:clamp(46px,8vw,104px);font-weight:900;text-transform:uppercase;line-height:.88;margin:8px 0 18px;letter-spacing:-.005em}
.mast h1 .amp{color:var(--em)}
.mast-act{display:flex;flex-direction:column;gap:10px;align-items:flex-end}
.stampbox{position:absolute;color:var(--brass)}
.stampbox svg{display:block;width:100%;height:auto}
.stamp-thud{position:fixed;left:50%;top:42%;width:min(280px,64vw);z-index:90;pointer-events:none;color:var(--lac);transform:translate(-50%,-50%) rotate(-12deg) scale(2.2);opacity:0;animation:thud 1.6s cubic-bezier(.2,1.2,.3,1) forwards}
@keyframes thud{0%{opacity:0;transform:translate(-50%,-50%) rotate(-12deg) scale(2.2)}18%{opacity:.95;transform:translate(-50%,-50%) rotate(-12deg) scale(1)}70%{opacity:.95}100%{opacity:0;transform:translate(-50%,-50%) rotate(-12deg) scale(1)}}

/* Hallmark strip: the stats row, modelled on a jeweller's punch strip */
.hm{display:inline-grid;grid-auto-flow:column;grid-auto-columns:minmax(110px,auto);border:1.5px solid var(--rule);background:var(--card);max-width:100%;overflow-x:auto}
.hm-c{padding:10px 16px 9px;border-left:1.5px solid var(--rule);display:flex;flex-direction:column;gap:3px;min-width:0}
.hm-c:first-child{border-left:0}
.hm-c b{font-family:var(--f-mono);font-size:22px;font-weight:600;line-height:1.1;font-variant-numeric:tabular-nums;white-space:nowrap}
.hm-c small{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.hm-c.id{background:var(--ink);color:var(--paper)}
.hm-c.id small{color:color-mix(in srgb,var(--paper) 70%,transparent)}
.hm-c.id b{font-size:16px}
.hm-c.hot b{color:var(--em)}

/* ---------- Page ---------- */
.page{max-width:1240px;margin:0 auto;padding:28px 20px 80px}
.cols{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:28px;align-items:start}
.rail{display:grid;gap:20px;position:sticky;top:calc(78px + env(safe-area-inset-top,0px))}
.panel{background:var(--card);border:1.5px solid var(--rule);padding:18px 20px 20px;margin-bottom:20px;min-width:0}
.rail .panel{margin:0}
.panel > h2,.sec-h h2{font-size:26px;text-transform:uppercase;margin:0 0 4px}
.panel h3{font-family:var(--f-mono);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin:16px 0 8px;color:var(--ink-2)}
.panel p{max-width:70ch;margin:6px 0}
.sec-h,.feedbar{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;justify-content:space-between;margin:0 0 14px;padding-bottom:10px;border-bottom:1.5px solid var(--rule)}
.feedbar h2{font-size:30px;text-transform:uppercase}
.two-col{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:20px}
.two-col > .panel{margin-bottom:0}
.two-col + .panel,.two-col + section{margin-top:20px}

/* Segmented filters */
.chipset{display:inline-flex;flex-wrap:wrap;border:1.5px solid var(--rule)}
.chipset button{border:0;border-left:1.5px solid var(--rule);background:var(--card);padding:6px 12px;font-size:13px;font-weight:600;cursor:pointer}
.chipset button:first-child{border-left:0}
.chipset button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}
.seg{display:grid;grid-template-columns:repeat(3,1fr);border:1.5px solid var(--rule)}
.seg button{border:0;border-left:1.5px solid var(--rule);background:var(--card);padding:10px 6px;font-weight:700;cursor:pointer}
.seg button:first-child{border-left:0}
.seg button.sel{background:var(--ink);color:var(--paper)}

/* ---------- Wall: recognition price-tags ---------- */
.ticket{display:grid;grid-template-columns:104px minmax(0,1fr);background:var(--card);border:1.5px solid var(--rule);min-width:0}
.ticket + .ticket{margin-top:14px}
.ticket.pending{border-style:dashed}
.stub{position:relative;background:var(--vc);color:#fff;padding:30px 10px 12px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;border-right:1.5px solid var(--rule)}
.stub::before{content:"";position:absolute;top:10px;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:var(--paper);border:1.5px solid var(--rule)}
.stub .code{font-family:var(--f-disp);font-weight:900;font-size:40px;line-height:.9;letter-spacing:.02em}
.stub .vname{font-size:11.5px;font-weight:600;line-height:1.25;opacity:.95}
.stub .spts{margin-top:auto;font-family:var(--f-mono);font-size:12px;font-weight:600;background:rgba(0,0,0,.25);padding:2px 6px}
.tbody{padding:14px 18px 12px;min-width:0}
.thead{font-size:15.5px;line-height:1.4}
.thead b{font-weight:700}
.tmeta{font-family:var(--f-mono);font-size:11.5px;color:var(--muted);letter-spacing:.04em;text-transform:uppercase;margin-top:3px;display:flex;flex-wrap:wrap;gap:4px 12px}
.tmeta .k{color:var(--ink-2)}
.rmsg{margin:10px 0 0;font-size:17px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere;max-width:62ch}
.boosts{font-family:var(--f-mono);font-size:12px;margin-top:8px;color:var(--brass)}
.racts{display:flex;flex-wrap:wrap;gap:4px 6px;margin-top:12px;align-items:center;border-top:1px dashed var(--hair);padding-top:10px}
.rx{border:1px solid var(--hair);background:transparent;padding:3px 8px;font-size:14px;cursor:pointer;display:inline-flex;gap:4px;align-items:center;border-radius:2px}
.rx.on{border-color:var(--ink);background:var(--brass-soft)}
.rx small{font-family:var(--f-mono);font-weight:600;font-size:12px}
.rlink{border:0;background:none;color:var(--ink-2);font-size:13px;font-weight:600;cursor:pointer;padding:4px 6px;text-decoration:none}
.rlink:hover{color:var(--em);text-decoration:underline}
.racts .sp{flex:1}
.avs{display:flex}
.av{width:44px;height:44px;border-radius:50%;display:inline-grid;place-items:center;color:#fff;font-weight:700;font-size:15px;border:2px solid var(--card);flex:none}
.av.sm{width:32px;height:32px;font-size:12px}
.badge{display:inline-flex;align-items:center;gap:6px;padding:2px 8px;font-size:12px;font-weight:700;color:#fff}
.ptsp{font-family:var(--f-mono);font-size:12px;font-weight:600;color:var(--brass);border:1px solid currentColor;padding:1px 6px}
.kindp{font-family:var(--f-mono);font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.st-pill{display:inline-block;font-family:var(--f-mono);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;padding:2px 7px;border:1px solid currentColor}
.st-pending{color:var(--warn);background:var(--warn-soft)}
.st-approved,.st-fulfilled{color:var(--ok);background:var(--ok-soft)}
.st-rejected{color:var(--lac);background:var(--lac-soft)}
.more{text-align:center;margin-top:18px}

/* Rail lists */
.dates{list-style:none;margin:6px 0 0;padding:0}
.dates li{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--hair)}
.dates li:first-child{border-top:0}
.dbox{border:1.5px solid var(--rule);text-align:center;line-height:1;padding:5px 0 4px}
.dbox b{display:block;font-family:var(--f-disp);font-weight:900;font-size:24px}
.dbox small{font-family:var(--f-mono);font-size:10px;text-transform:uppercase;letter-spacing:.08em}
.dbox.bd{background:var(--brass-soft)}
.dbox.an{background:var(--em-soft)}
.dates .nm{font-weight:700;font-size:14px;overflow-wrap:anywhere}
.dates .ds{font-size:12px;color:var(--muted)}
.mini{list-style:none;margin:6px 0 0;padding:0;counter-reset:r}
.mini li{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-top:1px solid var(--hair);font-size:14px}
.mini li:first-child{border-top:0}
.rk{font-family:var(--f-mono);font-weight:600;color:var(--muted);margin-right:6px}
.mini b{font-family:var(--f-mono)}
.mini-kpi{display:flex;gap:6px 18px;flex-wrap:wrap;font-size:14px;color:var(--muted);margin-top:8px}
.mini-kpi b{color:var(--ink);font-family:var(--f-mono)}

/* Celebrations (team / admin) */
.celebs{display:flex;gap:12px;overflow-x:auto;padding:2px 2px 8px}
.celeb{flex:0 0 auto;width:200px;border:1.5px solid var(--rule);background:var(--card);padding:12px;display:grid;gap:6px}

/* Wallet + catalogue */
.wallet{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));border:1.5px solid var(--rule);margin-bottom:20px;background:var(--card)}
.wbox{padding:16px 18px;border-left:1.5px solid var(--rule)}
.wbox:first-child{border-left:0}
.wbox b{display:block;font-family:var(--f-mono);font-size:30px;font-weight:600;line-height:1.15;font-variant-numeric:tabular-nums}
.wbox span{font-family:var(--f-mono);font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.wbox.main{background:var(--em);color:var(--on-em)}
.wbox.main span{color:inherit;opacity:.8}
.catgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(210px,100%),1fr));gap:0;border-top:1.5px solid var(--rule);border-left:1.5px solid var(--rule)}
.item{border-right:1.5px solid var(--rule);border-bottom:1.5px solid var(--rule);padding:16px;display:grid;gap:8px;align-content:start;background:var(--card)}
.item .ie{font-size:34px;line-height:1}
.item .ic{font-family:var(--f-mono);font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.item b{font-size:15px;line-height:1.3}
.item .ip{font-family:var(--f-mono);font-size:19px;font-weight:600}
.item .need{font-size:12px;color:var(--muted)}
.prog{height:6px;background:var(--paper-2);border:1px solid var(--hair)}
.prog i{display:block;height:100%;background:var(--brass)}

/* Badges: hexagonal hallmark marks */
.bcoll{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:12px}
.bt{text-align:center;padding:4px 2px}
.bt .hex{width:76px;height:84px;margin:0 auto 6px;display:grid;place-items:center;background:var(--vc);color:#fff;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);font-family:var(--f-disp);font-weight:900;font-size:28px}
.bt b{display:block;font-size:13px;line-height:1.25}
.bt .bn{font-family:var(--f-mono);font-size:13px;font-weight:600;color:var(--muted)}
.bt.zero .hex{background:var(--paper-2);color:var(--muted);outline:1px dashed var(--hair)}
.bt.zero b{color:var(--muted)}

/* Team */
.meterbar{height:12px;border:1.5px solid var(--rule);background:var(--paper-2);margin:12px 0 6px}
.meterbar i{display:block;height:100%;background:var(--em)}
.rankbig{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin:10px 0 4px}
.rankbig .n{font-family:var(--f-disp);font-weight:900;font-size:72px;line-height:.9;color:var(--em)}
.nudge{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid var(--hair)}
.nudge:first-of-type{border-top:0}
.nudge .who{display:flex;gap:10px;align-items:center;min-width:0}
.nudge .who div{min-width:0}
.nudge small{display:block;color:var(--muted);font-size:12px}
.gap{font-family:var(--f-mono);font-size:12px;color:var(--lac);font-weight:600}

/* Leaderboard */
