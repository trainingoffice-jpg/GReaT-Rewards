  const bits = await crypto.subtle.deriveBits({name:"PBKDF2", salt:enc.encode(salt + ":" + key), iterations:150000, hash:"SHA-256"}, base, 256);
  return Array.from(new Uint8Array(bits)).map(b => b.toString(16).padStart(2,"0")).join("");
