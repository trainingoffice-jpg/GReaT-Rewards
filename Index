function celebrations(fromDate, days, filter){
  const out = [], base = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate());
  staffList().forEach(r => {
    if (filter && !filter(r)) return;
    for (let i=0;i<days;i++){
      const d = new Date(base.getTime() + i*DAY), md = pad(d.getMonth()+1) + "-" + pad(d.getDate());
