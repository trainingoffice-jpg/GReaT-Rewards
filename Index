function cmtsOf(id){ return coll("cmt").filter(x => x.r === id).sort((a,b) => a.ts - b.ts); }
function periodRange(p){
  const now = new Date(), end = Date.now();
  if (p === "month") return [new Date(now.getFullYear(), now.getMonth(), 1).getTime(), end];
  if (p === "quarter"){ const q = Math.floor(now.getMonth()/3)*3; return [new Date(now.getFullYear(), q, 1).getTime(), end]; }
  if (p === "year") return [new Date(now.getFullYear(), 0, 1).getTime(), end];
