  const c = p.querySelector("#upCancel"), g = p.querySelector("#upGo");
  if (c) c.onclick = () => { pendingUpload = null; softRender(); };
  if (g) g.onclick = async () => { g.disabled = true; g.textContent = "Saving…"; try { await saveStaff(pendingUpload.rows); pendingUpload = null; toast("Staff list saved"); softRender(); } catch(e){ g.disabled = false; toast("Not saved: " + errText(e) + ". Only the owner and editors of this page can upload staff."); } };
}

/* ----- CSV exports ----- */
function csv(rows){ return "﻿" + rows.map(r => r.map(v => { const s = String(v == null ? "" : v); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; }).join(",")).join("\r\n"); }
async function saveCsv(name, rows){ if (!downloads) return; try { await downloads.save({filename: name + "-" + today() + ".csv", data: csv(rows)}); } catch(e){ if (e && e.code !== "declined") toast("Couldn't save the file here."); } }

/* ----- Admin actions ----- */
async function adminAct(a, b){
  if (!isAdminActor()) return;
  const id = b.dataset.id;
  if (a === "dperiod"){ dashPeriod = b.dataset.v; return softRender(); }
  if (a === "apprec" || a === "rejrec"){ const r = docs["recog/" + id]; if (!r) return; await writeDoc("recog/" + id, Object.assign({}, r, {status: a === "apprec" ? "approved" : "rejected", approvedAt: Date.now()})); toast(a === "apprec" ? "Approved and posted to the wall" : "Declined"); return softRender(); }
  if (a === "fulfil" || a === "rejred"){
    const x = docs["redeem/" + id]; if (!x) return;
    const note = await askInput(a === "fulfil" ? "Mark as issued" : "Decline request", a === "fulfil" ? "Note for the employee (optional), e.g. voucher code sent by SMS" : "Reason (optional). The points go back to the employee.", "text");
    if (note === null) return;
    await writeDoc("redeem/" + id, Object.assign({}, x, {status: a === "fulfil" ? "fulfilled" : "rejected", note: note.trim().slice(0, 140), doneAt: Date.now()}));
    toast(a === "fulfil" ? "Marked as issued" : "Declined and points returned"); return softRender();
  }
  if (a === "awardms") return awardCelebrations("ms");
  if (a === "awardbd") return awardCelebrations("bd");
  if (a === "resetpw"){ const k = b.dataset.k; if (!await askConfirm("Reset the password for " + nameOf(k) + "? Their temporary password becomes the last 4 digits of their employee ID, and they choose a new one when they sign in.", "Reset")) return; await deleteDoc("pins/" + k); toast("Password reset"); return; }
  if (a === "xzero"){ const d = dashData(); return saveCsv("not-recognised", [["Employee ID","Name","Showroom","Department","Designation","Tenure","Last recognised"]].concat(d.staff.filter(r => !d.rcv.has(r.key) && (zeroDept === "all" || (r.dept || "Unassigned") === zeroDept)).map(r => { const l = lastRecognised(r.key); return [r.id, r.name, r.showroom, r.dept || "", r.designation || "", tenureBand(r.doj), l ? ymd(new Date(l)) : "Never"]; }))); }
  if (a === "xrec"){ const [from, to] = periodRange(dashPeriod); return saveCsv("recognitions", [["Date","Type","From","To (ID)","To (name)","Showroom","Value","Points each","Status","Message"]].concat(recs().filter(r => r.ts >= from && r.ts <= to).sort((x,y) => x.ts - y.ts).flatMap(r => (r.to||[]).map(t => [ymd(new Date(r.ts)), KIND[r.kind], nameOf(r.from), (master()[t]||{}).id || t, nameOf(t), (master()[t]||{}).showroom || "", valueOf(r.value).name, r.pts || 0, r.status || "approved", r.msg || ""])))); }
  if (a === "xred") return saveCsv("redemptions", [["Date","Employee ID","Name","Showroom","Reward","Points","Status","Note"]].concat(redeems().sort((x,y) => x.ts - y.ts).map(x => [ymd(new Date(x.ts)), (master()[x.key]||{}).id || x.key, nameOf(x.key), (master()[x.key]||{}).showroom || "", x.name, x.pts, x.status, x.note || ""])));
  if (a === "xbal") return saveCsv("points-balances", [["Employee ID","Name","Showroom","Earned","Redeemed","Balance"]].concat(staffList().map(r => { const w = walletOf(r.key); return [r.id, r.name, r.showroom, w.earned, w.spent, w.bal]; })));
}

async function removeSample(){
  const paths = Object.keys(docs).filter(k => docs[k] && docs[k].sample === true);
  if (!await askConfirm("Remove " + paths.length + " sample items (sample staff, wall posts, reactions, comments, redemptions and trial passwords)? Your own settings and catalogue stay. This can't be undone.", "Remove")) return;
  try { for (const p of paths) await deleteDoc(p); await deleteDoc("config/sample"); toast("Sample data removed"); softRender(); }
  catch(e){ toast("Not removed: " + errText(e)); }
}

/* =========================================================
   Demo data (stored only in this browser)
   ========================================================= */
function rng(seed){ return () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; }; }
async function buildDemo(){
  const R = rng(20261006), pick = a => a[Math.floor(R() * a.length)];
  const SRS = ["T NAGAR","VELACHERY","ANNA NAGAR","COIMBATORE","MADURAI","BENGALURU JAYANAGAR"];
  const FN = ["Priya","Karthik","Lakshmi","Arun","Divya","Suresh","Meena","Vignesh","Anitha","Ramesh","Kavya","Senthil","Deepa","Manoj","Revathi","Prakash","Sangeetha","Bala","Nandhini","Gokul","Harini","Rajesh","Swathi","Murali","Janani","Ashok","Pooja","Dinesh","Sowmya","Vijay"];
  const LN = ["Raman","Krishnan","Subramanian","Natarajan","Iyer","Reddy","Gowda","Pillai","Shankar","Venkatesh","Murthy","Rao","Kumar","Selvam","Rajan"];
  const DES = [["Sales Executive","Sales"],["Sales Executive","Sales"],["Senior Sales Executive","Sales"],["Sales Executive","Sales"],["Cashier","Accounts"],["Customer Relations Executive","Customer Service"],["Gold Smith","Operations"],["Stock Assistant","Operations"],["Sales Executive","Sales"]];
  const now = new Date(), Y = now.getFullYear(), M = now.getMonth(), D = now.getDate();
  const rows = [];
  for (let i=1;i<=60;i++){
    const id = "D" + (1000 + i), sr = (i === 60 ? "T NAGAR" : SRS[Math.floor((i-1) / 10) % SRS.length]) + " (Sample)";
    const isMgr = i % 10 === 1, d = i === 60 ? ["Regional Manager","Operations"] : isMgr ? ["Showroom Manager","Operations"] : DES[i % DES.length];
    const yj = 2008 + Math.floor(R() * 17), doj = (i % 9 === 0 ? (Y - 1 - (i % 11)) : yj) + "-" + pad(i % 9 === 0 ? M + 1 : 1 + Math.floor(R()*12)) + "-" + pad(1 + Math.floor(R()*27));
    let dob = (1975 + Math.floor(R()*25)) + "-" + pad(1 + Math.floor(R()*12)) + "-" + pad(1 + Math.floor(R()*27));
    if (i % 13 === 2){ const b = new Date(Y, M, D + (i % 6)); dob = (1980 + i % 15) + "-" + pad(b.getMonth()+1) + "-" + pad(b.getDate()); }
    rows.push({id, name: FN[(i*7) % FN.length] + " " + LN[(i*4 + Math.floor(i/30)) % LN.length], showroom: sr, dept: d[1], designation: d[0], grade: isMgr || i === 60 ? "M" + (i === 60 ? 3 : 1) : "S" + (1 + i % 3), doj, dob, gender: i % 3 === 0 ? "Male" : "Female"});
  }
  const out = {};
  out["staff/sample"] = {cols:SCOLS, n:rows.length, at:Date.now(), data: rows.map(r => SCOLS.map(c => r[c] == null ? "" : r[c]))};
  out[ADM_PATH] = Object.assign({id:ADMIN_ID}, await makeCred(ADM_KEY, "Admin@2026", "admin"));
  out["config/sample"] = {at: Date.now(), note:"Sample data for trying GReaT Rewards. Remove it from Admin > Settings."};
  const keys = rows.map(r => keyOf(r.id)), bySr = {}; rows.forEach(r => { (bySr[r.showroom] = bySr[r.showroom] || []).push(keyOf(r.id)); });
  const quiet = new Set(keys.filter((k, i) => i % 7 === 3));      // people nobody has recognised lately
  const vals = DEFAULT_VALUES.filter(v => v.k !== "celebrate").map(v => v.k), nowT = Date.now();
  let n = 0;
  for (let i=0;i<170;i++){
    const age = Math.pow(R(), 1.9) * 160 * DAY, ts = nowT - age - Math.floor(R()*3600e3);
    const mgrIdx = Math.floor(R()*6) * 10, mgrKey = keys[mgrIdx];
    const spot = R() < .28, from = spot ? (R() < .15 ? keys[59] : mgrKey) : pick(keys);
    const pool = spot ? (from === keys[59] ? keys : bySr[rows[mgrIdx].showroom]) : bySr[(rows[keys.indexOf(from)]).showroom].concat(R() < .3 ? [pick(keys)] : []);
    let cands = pool.filter(k => k !== from && !(quiet.has(k) && age < 35*DAY));
    if (!cands.length) continue;
    const to = [pick(cands)]; if (R() < .12){ const t2 = pick(cands); if (to.indexOf(t2) < 0) to.push(t2); }
    const v = pick(vals), msg = pick(TEMPLATES[v]);
    const pts = spot ? pick([100,100,250,250,500]) : pick([0,5,10,10,20]);
    const id = "demo" + (n++);
    out["recog/" + id] = {id, kind: spot ? "spot" : "peer", from, to, value: v, msg, pts, ts, status:"approved"};
    if (R() < .5 || age < 3*DAY){ const rc = 1 + Math.floor(R()*4); for (let j=0;j<rc;j++){ const k = pick(keys); out["react/" + id + "~" + k] = {r:id, k, e: pick(REACTS), ts}; } }
    if (R() < .18){ const c = {id: "dc" + n, r:id, k: pick(keys), text: pick(["Well deserved!","Congratulations, so happy for you.","The customers noticed too. Great job.","Thank you for this, team!","Superb work. Proud to work with you.","This is exactly what GRT is about."]), ts: ts + 3600e3}; out["cmt/" + c.id] = c; }
  }
  // make sure everyone has received something at some point, so every login has history
  const got = new Set(); Object.keys(out).forEach(p => { if (p.indexOf("recog/") === 0) (out[p].to || []).forEach(t => got.add(t)); });
  keys.forEach((k, i) => { if (got.has(k)) return; const from = pick(bySr[rows[i].showroom].filter(x => x !== k)) || keys[0], v = pick(vals), id = "demo" + (n++);
    out["recog/" + id] = {id, kind:"peer", from, to:[k], value:v, msg: pick(TEMPLATES[v]), pts: 10, ts: nowT - (40 + Math.floor(R()*100)) * DAY, status:"approved"}; });
  // two spot awards waiting for HR approval
  [[0, 12, 750], [59, 33, 1000]].forEach(([a, b, p], j) => { const id = "demopend" + j; out["recog/" + id] = {id, kind:"spot", from: keys[a], to:[keys[b]], value: j ? "customer" : "extra", msg: j ? "Closed the biggest bridal order of the quarter and handled the family with great care." : "Ran the counter alone through the festival rush and still kept every customer smiling.", pts:p, ts: nowT - (j + 1) * 5 * 3600e3, status:"pending"}; });
  // past work anniversaries (earlier months)
  rows.forEach(r => {
    const md = r.doj.slice(5), y = Y - +r.doj.slice(0,4), d = new Date(Y, +md.slice(0,2) - 1, +md.slice(3));
    if (y >= 1 && d.getTime() < new Date(Y, M, 1).getTime() && nowT - d.getTime() < 170*DAY){ const id = "ms-" + keyOf(r.id) + "-" + Y; out["recog/" + id] = {id, kind:"milestone", from:"admin", to:[keyOf(r.id)], value:"celebrate", years:y, pts: DEFAULT_SETTINGS.ms[String(y)] != null ? DEFAULT_SETTINGS.ms[String(y)] : DEFAULT_SETTINGS.otherYearPts, ts: d.getTime() + 10*3600e3, status:"approved", msg:"Congratulations on " + y + " years with GRT! Thank you for your dedication."}; }
  });
  // redemptions
  [[3,"c4",300,"fulfilled"],[5,"c6",600,"fulfilled"],[14,"c3",500,"fulfilled"],[22,"c10",250,"pending"],[8,"c4",300,"pending"],[41,"c6",600,"pending"]].forEach(([i, it, p, st], j) => {
    const c = DEFAULT_CATALOG.find(x => x.id === it), id = "dr" + j; out["redeem/" + id] = {id, key: keys[i], item: it, name: c.name, e: c.e, pts: p, ts: nowT - (j + 1) * 6 * DAY, status: st, doneAt: st === "fulfilled" ? nowT - j * 5 * DAY : undefined, note: st === "fulfilled" ? "Voucher code sent by SMS" : ""};
  });
  Object.keys(out).forEach(p => { if (p !== "config/sample" && p !== ADM_PATH) out[p].sample = true; });
  return JSON.parse(JSON.stringify(out));
}
function enterDemo(){ lsSet("sr-demo", "1"); signOutAll(); sessSet("sr-view", null); location.reload(); }
function exitDemo(){ lsSet("sr-demo", null); signOutAll(); sessSet("sr-view", null); location.reload(); }
async function resetDemo(){ if (!await askConfirm("Reset the demo to fresh sample data? Anything you changed in the demo will be lost.")) return; docs = await buildDemo(); VER++; saveLocal(); signOutAll(); go("login"); toast("Demo data reset"); }
function demoBar(){
  let el = document.getElementById("demoBar");
  if (mode !== "demo"){ if (el) el.remove(); return; }
  if (!el){ el = document.createElement("div"); el.id = "demoBar"; el.className = "demobar"; document.body.appendChild(el);
    el.innerHTML = '<span>🎬 <span class="dtxt-long">Demo mode: sample data only</span><span class="dtxt-short">Demo</span></span><button type="button" id="demoReset">Reset</button><button type="button" id="demoExit">Exit demo</button>';
    el.querySelector("#demoExit").onclick = exitDemo; el.querySelector("#demoReset").onclick = resetDemo; }
}

/* =========================================================
   Start-up
   ========================================================= */
const COLLS = ["config","staff","pins","recog","react","cmt","redeem"];
const loaded = {};
let firstReady = true, readyTimer = null;
function ready(){
  if (!COLLS.every(c => loaded[c])) return;
  if (firstReady){ firstReady = false; render(); return; }
  clearTimeout(readyTimer); readyTimer = setTimeout(() => { if (cmOpen && $("#dlgCm").open && !(document.activeElement && document.activeElement.id === "cmText")) openComments(cmOpen); softRender(); }, 120);
}
async function init(){
  render();
  const use = n => (window.claude && window.claude.use) ? window.claude.use(n).catch(() => null) : Promise.resolve(null);
  use("downloads").then(d => { downloads = d; if (d && mode !== "loading") softRender(); });
  use("sample").then(s => { sampleFn = s; });
  if (DEMO_ON){
    mode = "demo"; isOwnerEditor = true;
    try { const raw = localStorage.getItem(DEMO_KEY); docs = raw ? (JSON.parse(raw) || {}) : {}; } catch(e){ docs = {}; }
    if (!docs["config/demo"]){ docs = await buildDemo(); saveLocal(); }
    VER++; render(); return;
  }
  db = await use("db");
  if (db){
    mode = "shared";
    use("user").then(async u => { try { isOwnerEditor = u ? ((await u.isOwner()) || (await u.canEdit())) : false; } catch(e){ isOwnerEditor = false; } if (view === "login" && !firstReady) renderLogin(); });
    const onErr = e => toast("Sync problem: " + errText(e));
    COLLS.forEach(col => db.collection(col).onSnapshot(qs => {
      Object.keys(docs).filter(k => k.indexOf(col + "/") === 0).forEach(k => delete docs[k]);
      qs.docs.forEach(d => { if (d.exists) docs[col + "/" + d.id] = clone(d.data()); });
      VER++; loaded[col] = true; ready();
    }, onErr));
  } else {
    mode = "local"; isOwnerEditor = true;
    try { const raw = localStorage.getItem(LOCAL_KEY); if (raw) docs = JSON.parse(raw) || {}; } catch(e){ docs = {}; }
    if (!Object.keys(docs).length){ docs = await buildDemo(); saveLocal(); }
    VER++; render();
  }
}
init();
})();
