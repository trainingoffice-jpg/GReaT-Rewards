const COLS = [
  {k:"id",   re:/^(emp(loyee)?\s*(id|code|no|number)|staff\s*(id|code|no)|e\s*code|ecode|id|code)$/},
  {k:"name", re:/^(emp(loyee)?\s*name|staff\s*name|name|full\s*name)$/},
  {k:"showroom", re:/(showroom|branch|store|outlet|location)/},
  {k:"dept", re:/^(department|dept)$/},
  {k:"designation", re:/(designation|role|position|job\s*title)/},
  {k:"grade", re:/^(grade|band|level)$/},
  {k:"doj", re:/^(doj|d o j|date\s*of\s*joining|joining\s*date|date\s*joined)$/},
  {k:"dob", re:/^(dob|d o b|date\s*of\s*birth|birth\s*date|birthday)$/},
  {k:"gender", re:/^(gender|sex)$/},
  {k:"mobile", re:/^(mobile|phone|mobile\s*(no|number)|contact)$/}
];
function normHeader(h){ return String(h == null ? "" : h).toLowerCase().replace(/[_\.]+/g," ").replace(/\s+/g," ").trim(); }
function parseDate(v){
  if (v == null || v === "") return "";
  if (v instanceof Date && !isNaN(v)) return ymd(v);
  if (typeof v === "number" && v > 1000 && v < 80000 && typeof XLSX !== "undefined"){ const d = XLSX.SSF.parse_date_code(v); if (d) return d.y + "-" + pad(d.m) + "-" + pad(d.d); }
  const t = String(v).trim(); let m;
  if ((m = t.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/))) return m[1] + "-" + pad(m[2]) + "-" + pad(m[3]);
  if ((m = t.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})$/))){ let y = +m[3]; if (y < 100) y += y > 40 ? 1900 : 2000; return y + "-" + pad(m[2]) + "-" + pad(m[1]); }
  const mon = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
  if ((m = t.match(/^(\d{1,2})[-\s\/.]([A-Za-z]{3})[A-Za-z]*[-\s\/.,]*(\d{2,4})$/)) && mon[m[2].toLowerCase()]){ let y = +m[3]; if (y < 100) y += y > 40 ? 1900 : 2000; return y + "-" + pad(mon[m[2].toLowerCase()]) + "-" + pad(m[1]); }
  return "";
}
function parseSheet(aoa){
  let hRow = -1, map = null;
  for (let i=0;i<Math.min(15, aoa.length);i++){
    const m = {}; (aoa[i] || []).forEach((h, j) => { const n = normHeader(h); if (!n) return; const c = COLS.find(c => m[c.k] == null && c.re.test(n)); if (c) m[c.k] = j; });
    if (m.id != null && m.name != null){ hRow = i; map = m; break; }
  }
  if (hRow < 0) return {error:"Couldn't find the header row. The sheet needs columns named Employee ID and Employee Name."};
  const rows = [], seen = {}, dupes = [];
  for (let i=hRow+1;i<aoa.length;i++){
    const r = aoa[i] || [], id = String(r[map.id] == null ? "" : r[map.id]).trim(), name = String(r[map.name] == null ? "" : r[map.name]).trim();
    if (!id) continue; const k = keyOf(id); if (seen[k]){ dupes.push(id); continue; } seen[k] = 1;
    const o = {id, name: name || id};
    ["showroom","dept","designation","grade","mobile"].forEach(c => { if (map[c] != null){ const v = String(r[map[c]] == null ? "" : r[map[c]]).trim(); if (v) o[c] = v.slice(0, 80); } });
    ["doj","dob"].forEach(c => { if (map[c] != null){ const d = parseDate(r[map[c]]); if (d) o[c] = d; } });
    if (map.gender != null){ const g = String(r[map.gender] || "").trim().toLowerCase(); o.gender = g === "m" || g === "male" ? "Male" : g === "f" || g === "female" ? "Female" : (g ? String(r[map.gender]).trim() : undefined); if (!o.gender) delete o.gender; }
    rows.push(o);
  }
  return {rows, map, dupes};
}
