function keyOf(id){ return String(id).trim().replace(/[^A-Za-z0-9_\-.:@+]/g, "_").slice(0, 120) || "_"; }
function staffList(){
  return memo("staff", () => {
    const main = docs["staff/p0"] || {parts:0};
    const cols = main.cols || SCOLS, out = [];
    for (let i=0;i<(main.parts||1);i++){ const p = docs["staff/p" + i]; if (!p || !p.data) continue;
      p.data.forEach(a => { const o = {}; cols.forEach((k,j) => { if (a[j] != null && a[j] !== "") o[k] = a[j]; }); o.key = keyOf(o.id); if (!o.showroom) o.showroom = "Unassigned"; out.push(o); }); }
    const sm = docs["staff/sample"];
    if (sm && sm.data){ const seen = new Set(out.map(r => r.key)); sm.data.forEach(a => { const o = {sample:true}; (sm.cols || SCOLS).forEach((k,j) => { if (a[j] != null && a[j] !== "") o[k] = a[j]; }); o.key = keyOf(o.id); if (!seen.has(o.key)) out.push(o); }); }
